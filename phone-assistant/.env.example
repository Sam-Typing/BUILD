# ---- Pick at least ONE AI provider key ----
# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ---- Lock the app so only you can use it (comma-separated passwords) ----
CODE=change-me

# ---- Optional ----
# Model shown by default, e.g. claude-sonnet-4-5 or gpt-4o
DEFAULT_MODEL=
# Set to 1 to stop visitors entering their own API key
HIDE_USER_API_KEY=1
